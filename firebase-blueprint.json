{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 50, "minLength": 1 },
        "username": { "type": "string", "maxLength": 30, "minLength": 3, "pattern": "^[a-zA-Z0-9_]+$" },
        "usernameLower": { "type": "string", "maxLength": 30, "minLength": 3, "pattern": "^[a-z0-9_]+$" },
        "email": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "bio": { "type": "string", "maxLength": 300 },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "username", "usernameLower"]
    },
    "UsernameIndex": {
      "title": "UsernameIndex",
      "description": "Mapping from normalized username to uid for unique reservation",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "1-on-1 Conversation container",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 256 },
        "participantIds": { "type": "array" },
        "participants": { "type": "object" },
        "lastMessage": { "type": "object" },
        "unreadCount": { "type": "object" },
        "typing": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantIds", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Single chat message within a conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 256 },
        "senderId": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 4000 },
        "type": { "type": "string", "enum": ["text", "image", "file", "system"] },
        "fileUrl": { "type": "string", "maxLength": 1024 },
        "fileName": { "type": "string", "maxLength": 256 },
        "fileSize": { "type": "number" },
        "replyTo": { "type": "object" },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "edited": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "conversationId", "type", "createdAt"]
    },
    "Contact": {
      "title": "Contact",
      "description": "User contact relationship",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "contactUserId": { "type": "string", "maxLength": 128 },
        "isFavorite": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "contactUserId"]
    },
    "Call": {
      "title": "Call",
      "description": "WebRTC Call session record and signaling",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "callerId": { "type": "string", "maxLength": 128 },
        "callerName": { "type": "string", "maxLength": 100 },
        "callerPhoto": { "type": "string", "maxLength": 1024 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "receiverName": { "type": "string", "maxLength": 100 },
        "receiverPhoto": { "type": "string", "maxLength": 1024 },
        "type": { "type": "string", "enum": ["voice", "video"] },
        "status": { "type": "string", "enum": ["ringing", "accepted", "rejected", "ended", "missed"] },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "duration": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["callerId", "receiverId", "type", "status", "createdAt"]
    },
    "IceCandidate": {
      "title": "IceCandidate",
      "description": "WebRTC ICE Candidate for signaling",
      "type": "object",
      "properties": {
        "candidate": { "type": "string", "maxLength": 2048 },
        "sdpMid": { "type": "string", "maxLength": 128 },
        "sdpMLineIndex": { "type": "number" },
        "senderId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["candidate", "senderId"]
    },
    "BlockedUser": {
      "title": "BlockedUser",
      "description": "Blocked user record",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string", "maxLength": 128 },
        "blockedUserId": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "blockedUserId"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "User report against inappropriate behavior",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "maxLength": 128 },
        "reportedUserId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "reportedUserId", "reason"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app and push notification record",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "body": { "type": "string", "maxLength": 512 },
        "type": { "type": "string", "enum": ["message", "call", "contact", "system"] },
        "link": { "type": "string", "maxLength": 256 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "body", "type", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection"
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameIndex" },
      "description": "Unique username reservations index"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "1-on-1 Conversations between users"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages belonging to a conversation"
    },
    "/users/{userId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "User personal contact list"
    },
    "/users/{userId}/blocked/{blockedId}": {
      "schema": { "$ref": "#/entities/BlockedUser" },
      "description": "User blocked accounts"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/Call" },
      "description": "Call signaling and history records"
    },
    "/calls/{callId}/candidates/{candidateId}": {
      "schema": { "$ref": "#/entities/IceCandidate" },
      "description": "ICE candidate signaling subcollection"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "User reports for moderation"
    }
  }
}
